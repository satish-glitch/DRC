<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GST_Customer_type_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(DRC_NBC_Type__c, &quot;Shipping&quot;),
    ISBLANK(TEXT(DRC_Shipping_Gst_Customer_Type__c))
)</errorConditionFormula>
    <errorDisplayField>DRC_Shipping_Gst_Customer_Type__c</errorDisplayField>
    <errorMessage>GST Type is mandatory for Shipping Address.</errorMessage>
</ValidationRule>
