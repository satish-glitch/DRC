<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Co_ordinator_Status</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    $Profile.Name = &quot;Sales Co-ordinator&quot;,
    ISCHANGED(Status)
)</errorConditionFormula>
    <errorMessage>You  cannot change Order Status.</errorMessage>
</ValidationRule>
