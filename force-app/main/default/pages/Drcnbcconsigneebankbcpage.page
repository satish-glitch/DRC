<apex:page controller="DRC_NBC_ConsigneeBankBCPageController" action="{!enqueueSync}" sidebar="false" showHeader="true" tabStyle="Account">

    <apex:form >
        <apex:pageBlock title="Consignee Bank Sync">

            <apex:outputPanel id="msgBlock">
                <apex:outputPanel rendered="{!messageType == 'SUCCESS'}">
                    <div style="background-color:#d4edda; border:1px solid #28a745; color:#155724;
                                padding:12px 16px; border-radius:4px; margin-bottom:15px; font-size:14px;">
                        <strong>Success:</strong> {!messageText}
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!messageType == 'ERROR'}">
                    <div style="background-color:#f8d7da; border:1px solid #dc3545; color:#721c24;
                                padding:12px 16px; border-radius:4px; margin-bottom:15px; font-size:14px;">
                        <strong>Error:</strong> {!messageText}
                    </div>
                </apex:outputPanel>
            </apex:outputPanel>

            <apex:pageBlockButtons location="bottom">
                <apex:commandButton value="Check Status" action="{!checkStatus}" reRender="msgBlock" rendered="{!showStatusCheck}"/>
                <apex:commandButton value="Close" action="{!closeAndReturn}"/>
            </apex:pageBlockButtons>

        </apex:pageBlock>
    </apex:form>

</apex:page>